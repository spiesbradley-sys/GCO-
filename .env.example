# ─────────────────────────────────────────────────────────────────────────────
# GCO Partners Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All values below are PLACEHOLDERS.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local PostgreSQL for dev) ──────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://gco:gco@localhost:5432/gco_platform?schema=public"

# ── Auth.js / NextAuth core ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Base URL of the app (used for callbacks). No trailing slash.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── OAuth providers (sign-in) ────────────────────────────────────────────────
# TODO: create OAuth apps and paste client id/secret.
AUTH_GOOGLE_ID="TODO-google-client-id"
AUTH_GOOGLE_SECRET="TODO-google-client-secret"

# Optional: Microsoft Entra ID (Office 365 accountants)
# AUTH_MICROSOFT_ENTRA_ID_ID="TODO"
# AUTH_MICROSOFT_ENTRA_ID_SECRET="TODO"
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="TODO"

# ── Email (magic-link / password reset delivery) ─────────────────────────────
# TODO: configure an SMTP transport or transactional email provider.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="TODO"
EMAIL_SERVER_PASSWORD="TODO"
EMAIL_FROM="GCO Partners <no-reply@gcopartners.example>"

# ── Stripe (payments — provider-hosted only) ─────────────────────────────────
# The app NEVER handles raw card/bank numbers. Card entry happens in Stripe's UI.
# TODO: paste keys from the Stripe dashboard (use TEST keys in dev).
STRIPE_SECRET_KEY="sk_test_TODO"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_TODO"
# From `stripe listen` (dev) or the webhook endpoint settings (prod).
STRIPE_WEBHOOK_SECRET="whsec_TODO"

# ── Accounting system links (OAuth — tokens only, never credentials) ─────────
# QuickBooks Online
QBO_CLIENT_ID="TODO"
QBO_CLIENT_SECRET="TODO"
QBO_REDIRECT_URI="http://localhost:3000/api/connections/quickbooks/callback"
QBO_ENVIRONMENT="sandbox"

# Xero
XERO_CLIENT_ID="TODO"
XERO_CLIENT_SECRET="TODO"
XERO_REDIRECT_URI="http://localhost:3000/api/connections/xero/callback"

# ── Bank feeds (Plaid — provider-hosted Link, tokens only) ───────────────────
PLAID_CLIENT_ID="TODO"
PLAID_SECRET="TODO"
PLAID_ENV="sandbox"

# ── Document storage ─────────────────────────────────────────────────────────
# TODO: point at an object store (S3-compatible). Never serve unauthenticated URLs.
STORAGE_BUCKET="gco-documents-dev"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="TODO"
STORAGE_SECRET_ACCESS_KEY="TODO"
STORAGE_ENDPOINT="http://localhost:9000"

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
